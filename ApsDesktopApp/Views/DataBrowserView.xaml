<UserControl x:Class="ApsDesktopApp.Views.DataBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApsDesktopApp.ViewModels"
             mc:Ignorable="d">
    <UserControl.Resources>

        <!-- Chevron toggle button -->
        <Style x:Key="ChevronToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow"
                                  Data="M 5 3 L 11 8 L 5 13"
                                  Stroke="{StaticResource TextMuted}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data"
                                        Value="M 3 5 L 8 11 L 13 5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeViewItem: clean chevron, hover highlight, accent selection. -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextPri}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd" Grid.Row="0"
                                    Background="Transparent" CornerRadius="4"
                                    Margin="0,1,4,1" Padding="2,4">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="Expander"
                                                  Style="{StaticResource ChevronToggle}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"/>
                                    <ContentPresenter x:Name="PART_Header"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="14,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid row with hover state -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPri}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <MultiTrigger.Setters>
                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                    </MultiTrigger.Setters>
                </MultiTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- status / hint -->
            <RowDefinition Height="*"/>      <!-- browser split -->
        </Grid.RowDefinitions>

        <!-- Header: title left, Refresh + Logs right -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Data Browser"
                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Refresh" Width="90"
                        Style="{StaticResource SecondaryBtn}"
                        Command="{Binding RefreshFoldersCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Logs" Width="56"
                        ToolTip="View application log"
                        Click="ShowLogs_Click"/>
            </StackPanel>
        </Grid>

        <!-- Status / hint row -->
        <TextBlock Grid.Row="1" Margin="0,0,0,6" TextWrapping="Wrap"
                   Style="{StaticResource CaptionText}"
                   Text="{Binding ProjectsStatus}"
                   Visibility="{Binding ProjectsStatus, Converter={StaticResource StringToVisibility}}"/>

        <!-- Browser: folder tree (left) + content inspector (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: folder tree (starts at project top folders) -->
            <TreeView x:Name="BrowserTree" Grid.Column="0"
                      ItemsSource="{Binding Folders}"
                      SelectedItemChanged="OnTreeSelectionChanged"
                      Background="Transparent" BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"
                                       FontSize="13" Foreground="{StaticResource Accent}"
                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="{StaticResource Border}"/>

            <!-- Right: toolbar + content grid + splitter + version history -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- Breadcrumb: "Project Files > 02 Shared > Subdir"
                     Separator is inside the ListBoxItem ControlTemplate so a plain
                     Trigger on (ItemsControl.AlternationIndex) collapses it for item 0.
                     TextBlock + MouseBinding used instead of Button to avoid dark-theme
                     template overriding the Foreground. -->
                <ListBox Grid.Row="0" ItemsSource="{Binding NavigationPath}"
                         AlternationCount="1000" Margin="0,0,0,4"
                         Background="Transparent" BorderThickness="0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"   Value="0"/>
                            <Setter Property="Margin"    Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="Sep" Text=" &gt; "
                                                       VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FolderNode}">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPri}"
                                       VerticalAlignment="Center"
                                       Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.NavigateToPathEntryCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status + naming violations -->
                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                               Text="{Binding FilesStatus}"
                               Visibility="{Binding FilesStatus,
                                            Converter={StaticResource StringToVisibility}}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding NamingStatus}"
                               Visibility="{Binding NamingStatus,
                                            Converter={StaticResource StringToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding NamingViolations}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Foreground="#E08A7A"
                                           Margin="0,1,0,1">
                                    <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Message, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Content grid: folders (top) then files -->
                <DataGrid Grid.Row="2" x:Name="FileGrid"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          PreviewMouseRightButtonDown="OnFileGridRightClick"
                          MouseDoubleClick="OnFileGridDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Convert file..."
                                      Command="{Binding OpenConverterCommand}"/>
                            <MenuItem Header="Check naming"
                                      Command="{Binding CheckNamingCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>

                        <!-- Name: folder icon OR file-type badge + name -->
                        <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,0">

                                        <!-- Folder icon (Segoe MDL2 folder glyph) -->
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"
                                                   FontSize="14" Foreground="{StaticResource Accent}"
                                                   Margin="0,0,7,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- File-type badge (hidden for folders) -->
                                        <Border Width="34" Height="20" CornerRadius="3"
                                                Background="#2E5E8E"
                                                Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileType}"
                                                       FontSize="9" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Version pill (empty for folders) -->
                        <DataGridTemplateColumn Header="Version" Width="76"
                                                SortMemberPath="Version">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10"
                                            BorderBrush="{StaticResource Accent}"
                                            BorderThickness="1"
                                            Padding="8,2" Margin="4,0"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding Version,
                                                         Converter={StaticResource StringToVisibility}}">
                                        <TextBlock Text="{Binding Version}" FontSize="11"
                                                   Foreground="{StaticResource Accent}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Size"
                                            Binding="{Binding Size}" Width="70"/>
                        <DataGridTextColumn Header="Modified"
                                            Binding="{Binding LastModified}" Width="Auto"/>
                        <DataGridTextColumn Header="Modified by"
                                            Binding="{Binding ModifiedBy}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" Margin="0,4"
                              Background="{StaticResource Border}"/>

                <!-- Version history panel -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,4"
                               Text="{Binding SelectedFile.Name,
                                      TargetNullValue='Version history',
                                      FallbackValue='Version history'}"/>

                    <TextBlock Grid.Row="1" Margin="0,0,0,4" TextWrapping="Wrap"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding VersionsStatus}"
                               Visibility="{Binding VersionsStatus,
                                            Converter={StaticResource StringToVisibility}}"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedFileVersions}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Version" Width="76"
                                                    SortMemberPath="Version">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                BorderBrush="{StaticResource Accent}"
                                                BorderThickness="1"
                                                Padding="8,2" Margin="4,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding Version,
                                                             Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Text="{Binding Version}" FontSize="11"
                                                       Foreground="{StaticResource Accent}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding FileType}" Width="Auto"/>
                            <DataGridTextColumn Header="Size"
                                                Binding="{Binding Size}" Width="Auto"/>
                            <DataGridTextColumn Header="Modified"
                                                Binding="{Binding LastModified}" Width="Auto"/>
                            <DataGridTextColumn Header="Modified by"
                                                Binding="{Binding ModifiedBy}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
