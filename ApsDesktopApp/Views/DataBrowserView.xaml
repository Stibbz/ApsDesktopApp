<UserControl x:Class="ApsDesktopApp.Views.DataBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApsDesktopApp.ViewModels"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Hubs &amp; Projects"
                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Refresh" Width="90"
                    Style="{StaticResource SecondaryBtn}"
                    Command="{Binding RefreshProjectsCommand}" />
        </Grid>

        <!-- Loading / empty-state message -->
        <TextBlock Grid.Row="1" Margin="0,4,0,4" TextWrapping="Wrap"
                   Style="{StaticResource CaptionText}"
                   Text="{Binding ProjectsStatus}"
                   Visibility="{Binding ProjectsStatus, Converter={StaticResource StringToVisibility}}" />

        <!-- Browser: folder tree (left) + file details/inspector (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="BrowserTree" Grid.Column="0"
                      ItemsSource="{Binding Hubs}"
                      SelectedItemChanged="OnTreeSelectionChanged"
                      Background="Transparent" BorderThickness="0">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:HubNode}"
                                              ItemsSource="{Binding Projects}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ProjectNode}"
                                              ItemsSource="{Binding Folders}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}"
                                              ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource Border}" />

            <!-- Right column: file grid (top) + metadata inspector (bottom) -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="{Binding SelectedFolderName, TargetNullValue='Files',
                                              FallbackValue='Files'}" />
                    <Button Grid.Column="1" Content="Check naming" Width="110"
                            Style="{StaticResource SecondaryBtn}"
                            Command="{Binding CheckNamingCommand}" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding FilesStatus}"
                               Visibility="{Binding FilesStatus,
                                            Converter={StaticResource StringToVisibility}}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding NamingStatus}"
                               Visibility="{Binding NamingStatus,
                                            Converter={StaticResource StringToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding NamingViolations}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Foreground="#E08A7A" Margin="0,1,0,1">
                                    <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="Auto" />
                        <DataGridTextColumn Header="Ver" Binding="{Binding Version}" Width="Auto" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding LastModified}" Width="Auto" />
                        <DataGridTextColumn Header="Modified by" Binding="{Binding ModifiedBy}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" Margin="0,4"
                              Background="{StaticResource Border}" />

                <!-- Metadata inspector: version history of the selected file -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,4"
                               Text="{Binding SelectedFile.Name, TargetNullValue='Version history',
                                              FallbackValue='Version history'}" />

                    <TextBlock Grid.Row="1" Margin="0,0,0,4" TextWrapping="Wrap"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding VersionsStatus}"
                               Visibility="{Binding VersionsStatus,
                                            Converter={StaticResource StringToVisibility}}" />

                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedFileVersions}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ver" Binding="{Binding Version}" Width="Auto" />
                            <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="Auto" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding LastModified}" Width="Auto" />
                            <DataGridTextColumn Header="Modified by" Binding="{Binding ModifiedBy}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
