<UserControl x:Class="ApsDesktopApp.Views.IssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="DarkColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource WindowBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="8,4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header + project picker -->
            <RowDefinition Height="Auto"/>   <!-- search + load -->
            <RowDefinition Height="Auto"/>   <!-- progress -->
            <RowDefinition Height="*"/>      <!-- grid -->
            <RowDefinition Height="Auto"/>   <!-- export / import -->
        </Grid.RowDefinitions>

        <!-- Header: title+description left, Logs button top-right -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Issues Manager" FontSize="18" FontWeight="SemiBold"
                           Margin="0,0,0,2"/>
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="Load all issues from an ACC project. Search and sort the table, then export to Excel for bulk editing. Import the workbook to push changes back."/>

                <!-- Unified project picker (single ComboBox, persists across tools) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Project" VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox  Grid.Column="1"
                               ItemsSource="{Binding ProjectContext.AllProjects}"
                               SelectedItem="{Binding ProjectContext.SelectedProject}"
                               DisplayMemberPath="DisplayName"
                               Height="28"
                               IsEnabled="{Binding ProjectContext.IsLoading,
                                           Converter={StaticResource InverseBool}}"/>
                    <!-- Spinner while projects are loading -->
                    <TextBlock Grid.Column="2" Margin="10,0,0,0"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Text="Loading projects..."
                               Visibility="{Binding ProjectContext.IsLoading,
                                            Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </StackPanel>

            <Button Grid.Column="1" Content="Logs" Width="56" Height="28"
                    VerticalAlignment="Top"
                    ToolTip="View application log"
                    Click="ShowLogs_Click"/>
        </Grid>

        <!-- Search + Load -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Search" VerticalAlignment="Center"
                       FontWeight="SemiBold" Margin="0,0,8,0"/>

            <!-- TextBox with watermark placeholder -->
            <Grid Grid.Column="1">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" Padding="6,0" VerticalContentAlignment="Center"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                <TextBlock Text="Filter by title, status, type, ID, name..."
                           Margin="8,0" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Show only when search box is empty -->
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="3" Content="Load Issues" Width="110" Height="28"
                    Style="{StaticResource PrimaryBtn}"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <!-- Progress bar -->
        <Grid Grid.Row="2" Margin="0,0,0,8"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" Height="6" VerticalAlignment="Center"
                         IsIndeterminate="True"/>

            <TextBlock Grid.Column="1" Margin="12,0,0,0"
                       Style="{StaticResource CaptionText}" VerticalAlignment="Center">
                <Run Text="Loading "/>
                <Run Text="{Binding LoadedCount, Mode=OneWay}"/>
                <Run Text=" / "/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text=" issues"/>
            </TextBlock>
        </Grid>

        <!-- Issues DataGrid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding IssuesView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource Border}"
                  Background="{StaticResource Surface}"
                  RowBackground="{StaticResource Surface}"
                  AlternatingRowBackground="{StaticResource Elevated}"
                  Foreground="{StaticResource TextPri}"
                  BorderBrush="{StaticResource Border}"
                  BorderThickness="1"
                  ColumnHeaderStyle="{StaticResource DarkColumnHeader}"
                  RowHeaderWidth="0"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"           Binding="{Binding DisplayId}"  Width="50"/>
                <DataGridTextColumn Header="Title"       Binding="{Binding Title}"       Width="*"   MinWidth="120"/>
                <DataGridTextColumn Header="Status"      Binding="{Binding Status}"      Width="90"/>
                <DataGridTextColumn Header="Type"        Binding="{Binding Type}"        Width="110"/>
                <DataGridTextColumn Header="Assigned To" Binding="{Binding AssignedTo}"  Width="120"/>
                <DataGridTextColumn Header="Created By"  Binding="{Binding CreatedBy}"   Width="120"/>
                <DataGridTextColumn Header="Owner"       Binding="{Binding Owner}"       Width="120"/>
                <DataGridTextColumn Header="Created At"  Binding="{Binding CreatedAt}"   Width="90"/>
                <DataGridTextColumn Header="Due Date"    Binding="{Binding DueDate}"     Width="90"/>
                <DataGridTextColumn Header="Closed At"   Binding="{Binding ClosedAt}"    Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Export / Import + status -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Export to Excel" Width="120"
                    Style="{StaticResource PrimaryBtn}"
                    Command="{Binding ExportCommand}"/>

            <Button Grid.Column="2" Content="Import from Excel" Width="130"
                    Command="{Binding ImportCommand}"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource CaptionText}">
                    <Run Text="{Binding IssueCount, Mode=OneWay}"/>
                    <Run Text=" issue(s) loaded"/>
                </TextBlock>
            </StackPanel>

            <TextBlock Grid.Column="5" Margin="16,0,0,0"
                       Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource TextPri}"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="{Binding Status}"
                       Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}"/>
        </Grid>

    </Grid>
</UserControl>
