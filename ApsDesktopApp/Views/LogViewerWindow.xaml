<Window x:Class="ApsDesktopApp.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Log"
        Width="960" Height="520"
        MinWidth="640" MinHeight="260"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPri}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- ListBoxItem with dark-theme selection highlight. Ctrl+C copies selected rows. -->
        <Style x:Key="LogItem" TargetType="ListBoxItem">
            <Setter Property="Padding"                   Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D3748"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3C4A5E"/>
                            </Trigger>
                            <!-- hover while selected: slightly brighter so both states are visible -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"  Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#4A5568"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="*"/>     <!-- log list -->
            <RowDefinition Height="Auto"/>  <!-- footer / file path -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Border}" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Min level:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="LevelFilter" Width="100"
                          SelectionChanged="LevelFilter_SelectionChanged"/>

                <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll"
                          IsChecked="True" VerticalAlignment="Center"
                          Foreground="{StaticResource TextPri}" Margin="16,0,0,0"/>

                <Button Content="Clear" Width="64" Height="26"
                        Margin="16,0,0,0" Click="ClearButton_Click"/>

                <Button Content="Open file" Width="80" Height="26"
                        Margin="8,0,0,0" Click="OpenLogFileButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Log list - Consolas for column alignment, virtualized for performance.
             Ctrl+C copies selected rows; right-click for context menu. -->
        <ListBox Grid.Row="1" x:Name="LogItems"
                 Background="{StaticResource WindowBg}"
                 BorderThickness="0"
                 Padding="4,2"
                 FontFamily="Consolas" FontSize="12"
                 SelectionMode="Extended"
                 ItemContainerStyle="{StaticResource LogItem}"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PreviewKeyDown="LogItems_PreviewKeyDown">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy" Click="CopyMenuItem_Click"
                              InputGestureText="Ctrl+C"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>   <!-- timestamp  -->
                            <ColumnDefinition Width="38"/>   <!-- level badge -->
                            <ColumnDefinition Width="150"/>  <!-- category   -->
                            <ColumnDefinition Width="*"/>    <!-- message    -->
                        </Grid.ColumnDefinitions>

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TimestampText}"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"/>

                        <!-- Level badge: coloured pill -->
                        <Border Grid.Column="1" CornerRadius="2" Margin="3,2,3,2"
                                HorizontalAlignment="Left" Padding="4,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- DBG default: dark surface -->
                                    <Setter Property="Background" Value="#3B4453"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelText}" Value="INF">
                                            <Setter Property="Background" Value="#0078D4"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LevelText}" Value="WRN">
                                            <Setter Property="Background" Value="#92600A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LevelText}" Value="ERR">
                                            <Setter Property="Background" Value="#9B1C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding LevelText}"
                                       Foreground="White"
                                       FontSize="10" FontWeight="Bold"/>
                        </Border>

                        <!-- Category -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Category}"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"/>

                        <!-- Message: colour by level -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Message}"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- DBG default: muted -->
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelText}" Value="INF">
                                            <Setter Property="Foreground" Value="{StaticResource TextPri}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LevelText}" Value="WRN">
                                            <Setter Property="Foreground" Value="#E5B800"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LevelText}" Value="ERR">
                                            <Setter Property="Foreground" Value="#E05252"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer: entry count and log file path -->
        <Border Grid.Row="2" Background="{StaticResource Border}" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="EntryCountText"
                           Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/>
                <TextBlock Text=" | " Foreground="{StaticResource TextMuted}"
                           FontFamily="Segoe UI"/>
                <TextBlock x:Name="LogFilePathText"
                           Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
