<UserControl x:Class="ApsDesktopApp.Views.FileConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">

        <!-- Header -->
        <TextBlock Text="File Converter" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="0,0,0,24"
                   Text="Convert a file stored in ACC to a different format without needing any desktop software. Paste the version link from the Data Browser, choose an output format, and click Convert. When the conversion is ready, click Download to save the file." />

        <!-- Step 1: version link -->
        <TextBlock Text="1. Version link" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   Text="Open the Data Browser, select a file version, and copy its link from the version history panel." />
        <TextBox Style="{StaticResource SettingInput}"
                 Margin="0,0,0,20"
                 Text="{Binding VersionUrn, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

        <!-- Step 2: output format -->
        <TextBlock Text="2. Output format" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   Text="Choose the format you want to receive. Not all formats work for every file type -- if conversion fails, the format may not be supported for that input." />
        <ComboBox ItemsSource="{Binding OutputFormats}"
                  SelectedItem="{Binding SelectedFormat}"
                  DisplayMemberPath="DisplayName"
                  Height="32" Margin="0,0,0,20"
                  Background="{StaticResource Surface}"
                  Foreground="{StaticResource TextPri}"
                  BorderBrush="{StaticResource Border}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Convert" Width="100" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryBtn}"
                    Command="{Binding ConvertCommand}" />
            <Button Content="Check status" Width="110"
                    Style="{StaticResource SecondaryBtn}"
                    Command="{Binding CheckStatusCommand}" />
        </StackPanel>

        <!-- Status text -->
        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="0,0,0,16"
                   Text="{Binding Status}"
                   Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}" />

        <!-- Download panel: only shown when conversion is complete -->
        <Border Background="{StaticResource Surface}" CornerRadius="6"
                Padding="16" Margin="0,0,0,0"
                Visibility="{Binding IsReadyToDownload,
                             Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="Conversion complete. Save the file to your computer." />
                <Button Style="{StaticResource PrimaryBtn}"
                        Command="{Binding DownloadCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Download " />
                        <TextBlock Text="{Binding SelectedFormat.FileExtension}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
