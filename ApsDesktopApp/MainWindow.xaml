<Window x:Class="ApsDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ApsDesktopApp.ViewModels"
        xmlns:views="clr-namespace:ApsDesktopApp.Views"
        mc:Ignorable="d"
        Title="APS Desktop App" Height="600" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPri}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Map each ViewModel type to its View -->
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataBrowserViewModel}">
            <views:DataBrowserView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_APS">
                <MenuItem Header="_Connect"
                          Command="{Binding ConnectCommand}" />
                <MenuItem Header="_Disconnect"
                          Command="{Binding DisconnectCommand}" />
                <Separator />
                <MenuItem Header="_Settings..." Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="2,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#C0392B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#27AE60" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Breadcrumb / back bar: only visible when a tool is active -->
        <Border DockPanel.Dock="Top" Padding="12,6"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsHome, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="&lt; Home" Style="{StaticResource SecondaryBtn}"
                        Padding="10,4" Command="{Binding GoHomeCommand}" />
                <TextBlock Text="{Binding CurrentToolName}"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Main content: disconnected splash or active tool/home -->
        <Grid>
            <!-- Disconnected splash -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="APS Desktop App" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Connect your Autodesk account to get started."
                           Style="{StaticResource CaptionText}"
                           FontSize="14" HorizontalAlignment="Center"
                           Margin="0,0,0,20" />
                <Button Content="Connect to APS" Padding="18,8" FontSize="14"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PrimaryBtn}"
                        Command="{Binding ConnectCommand}" />
                <TextBlock Text="Set your Client ID under APS &gt; Settings before connecting."
                           Style="{StaticResource CaptionText}"
                           FontSize="11" HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
            </StackPanel>

            <!-- Connected: ContentControl resolves ViewModel -> View via DataTemplates -->
            <ContentControl Margin="20"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"
                            Content="{Binding ActiveContent}" />
        </Grid>

    </DockPanel>
</Window>
