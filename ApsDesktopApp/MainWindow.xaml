<Window x:Class="ApsDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApsDesktopApp"
        mc:Ignorable="d"
        Title="APS Desktop App" Height="520" Width="860"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_APS">
                <MenuItem Header="_Connect"
                          Command="{Binding ConnectCommand}" />
                <MenuItem Header="_Disconnect"
                          Command="{Binding DisconnectCommand}" />
                <Separator />
                <MenuItem Header="_Settings..." Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="_Tools" IsEnabled="{Binding IsConnected}">
                <MenuItem Header="(no tools yet)" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="2,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#C0392B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#27AE60" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Content area -->
        <Grid>
            <!-- Welcome / disconnected prompt -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="APS Desktop App" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Connect your Autodesk account to get started."
                           FontSize="14" Foreground="#555" HorizontalAlignment="Center"
                           Margin="0,0,0,20" />
                <Button Content="Connect to APS" Padding="18,8" FontSize="14"
                        HorizontalAlignment="Center"
                        Command="{Binding ConnectCommand}" />
                <TextBlock Text="Set your Client ID under APS &gt; Settings before connecting."
                           FontSize="11" Foreground="#888" HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
            </StackPanel>

            <!-- Connected view -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="You're connected to APS" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="#555"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Tools will appear in the Tools menu as they're added."
                           FontSize="12" Foreground="#888" HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Grid>

    </DockPanel>
</Window>
