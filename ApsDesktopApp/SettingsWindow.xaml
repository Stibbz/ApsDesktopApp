<Window x:Class="ApsDesktopApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="APS Settings" Height="620" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPri}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Data Management (3-legged) section -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Model Derivative (2-legged) section -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- spacer + buttons -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Data Management (3-legged) ───────────────────────── -->
        <TextBlock Grid.Row="0" Text="Data Management App" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Margin="0,0,0,16"
                   TextWrapping="Wrap">
            <Run Text="Type:" FontWeight="SemiBold" />
            <Run Text="Desktop, Mobile, Single-Page App (PKCE - no client secret)." />
        </TextBlock>

        <TextBlock Grid.Row="2" Text="Client ID" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox Grid.Row="3" x:Name="ClientIdBox" Style="{StaticResource SettingInput}" Margin="0,0,0,16" />

        <TextBlock Grid.Row="4" Text="Data region" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox Grid.Row="5" x:Name="RegionBox" Margin="0,0,0,16" HorizontalAlignment="Left" Width="200">
            <ComboBoxItem Content="US (United States)" Tag="US" />
            <ComboBoxItem Content="EMEA (Europe)" Tag="EMEA" />
            <ComboBoxItem Content="AUS (Australia)" Tag="AUS" />
            <ComboBoxItem Content="CAN (Canada)" Tag="CAN" />
            <ComboBoxItem Content="DEU (Germany)" Tag="DEU" />
            <ComboBoxItem Content="IND (India)" Tag="IND" />
            <ComboBoxItem Content="JPN (Japan)" Tag="JPN" />
            <ComboBoxItem Content="GBR (United Kingdom)" Tag="GBR" />
        </ComboBox>

        <TextBlock Grid.Row="6" Margin="0,0,0,4">
            <Run Text="Redirect URI (register this exactly in the APS portal):" FontWeight="SemiBold" />
        </TextBlock>
        <TextBox Grid.Row="7" x:Name="RedirectUriBox" IsReadOnly="True"
                 Style="{StaticResource SettingInput}" Margin="0,0,0,20" />

        <!-- ── Model Derivative App (2-legged) ──────────────────── -->
        <TextBlock Grid.Row="8" Text="Model Derivative App" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="9" Style="{StaticResource CaptionText}" Margin="0,0,0,16"
                   TextWrapping="Wrap">
            <Run Text="Type:" FontWeight="SemiBold" />
            <Run Text="Server-side Web App (has client secret, enables Model Derivative API)." />
        </TextBlock>

        <TextBlock Grid.Row="10" Text="Client ID" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox Grid.Row="11" x:Name="MdClientIdBox" Style="{StaticResource SettingInput}" Margin="0,0,0,12" />

        <TextBlock Grid.Row="12" Text="Client Secret" FontWeight="SemiBold" Margin="0,0,0,4" />
        <PasswordBox Grid.Row="13" x:Name="MdClientSecretBox"
                     Background="{StaticResource Surface}"
                     Foreground="{StaticResource TextPri}"
                     BorderBrush="{StaticResource Border}"
                     BorderThickness="1" Padding="8,5"
                     Height="32"
                     PasswordChar="*" />

        <!-- ── Buttons ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"
                    Style="{StaticResource SecondaryBtn}" Click="Cancel_Click" />
            <Button Content="Save" Width="90" IsDefault="True"
                    Style="{StaticResource PrimaryBtn}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
