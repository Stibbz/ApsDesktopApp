<Window x:Class="ApsDesktopApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="APS Settings" Height="320" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Autodesk APS Connection" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,16"
                   Text="Register a 'Desktop, Mobile, Single-Page App' in the APS portal (no client secret needed) and paste its Client ID below." />

        <TextBlock Grid.Row="2" Text="Client ID" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox Grid.Row="3" x:Name="ClientIdBox" Padding="6" Margin="0,0,0,16" />

        <TextBlock Grid.Row="4" Margin="0,0,0,4">
            <Run Text="Redirect URI (register this exactly in the APS portal):" FontWeight="SemiBold" />
        </TextBlock>
        <TextBox Grid.Row="5" x:Name="RedirectUriBox" IsReadOnly="True" Padding="6"
                 VerticalAlignment="Top" Background="#F3F3F3" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Padding="0,6" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Save" Width="90" Padding="0,6" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
